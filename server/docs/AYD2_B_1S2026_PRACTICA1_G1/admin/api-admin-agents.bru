  token: {{TOKEN}}
}

body:json {
  {
    "email": "agente.base64@test.com",
    "name": "Carlos",
    "last_name": "García",
    "phone": "12345678",
    "img_mime": "image/png",
    "img_base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO9q0QAAAABJRU5ErkJggg=="
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
