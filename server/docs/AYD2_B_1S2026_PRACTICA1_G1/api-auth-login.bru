meta {
  name: /api/auth/login
  type: http
  seq: 2
}

post {
  url: {{URL}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "jaja@example.com",
    "password": "123456"
  }
}

script:post-response {
  // Obtener el cuerpo de la respuesta
  const response = res.body
  
  // Guardar en variables de colección
  bru.setGlobalEnvVar("TOKEN", response.data.token)
  bru.setVar("TOKEN", response.data.token)
  
  // Log para depuración
  console.log("TOKEN:", response)
  
}

settings {
  encodeUrl: true
  timeout: 0
}
