generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model USER {
  id_user    Int          @id(map: "user_pk") @default(autoincrement())
  email      String       @unique(map: "idx_user_email") @db.VarChar(30)
  // bcrypt hashes are typically 60 chars; use a wider column to support hashing
  password   String       @db.VarChar(255)
  gender     Decimal      @db.Decimal
  type       String       @db.VarChar(30)
  name       String       @db.VarChar(30)
  last_name  String       @db.VarChar(30)
  url_img    String?      @db.VarChar(150)
  phone      String       @db.VarChar(9)
  created_at DateTime     @db.Timestamp(6)
  favorite   favorite[]
  invitation invitation[]
  property   property[]
  record     record[]
}

model favorite {
  id_favorite Int      @id(map: "favorite_pk") @default(autoincrement())
  created_at  DateTime @db.Timestamp(6)
  id_client   Int
  id_property Int
  property    property @relation(fields: [id_property], references: [id_property], onDelete: Cascade, onUpdate: NoAction, map: "favorite_property_fk")
  USER        USER     @relation(fields: [id_client], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "favorite_user_fk")
}

model image {
  id_image    Int      @id(map: "image_pk") @default(autoincrement())
  correlative Decimal  @db.Decimal(3, 0)
  url_img     String   @db.VarChar(150)
  id_property Int
  property    property @relation(fields: [id_property], references: [id_property], onDelete: Cascade, onUpdate: NoAction, map: "image_property_fk")
}

model invitation {
  id_invitation Int       @id(map: "invitation_pk") @default(autoincrement())
  status        String    @db.VarChar(30)
  created_at    DateTime  @db.Timestamp(6)
  updated_at    DateTime  @db.Timestamp(6)
  is_accepted   Decimal?  @db.Decimal
  justification String?   @db.VarChar(300)
  description   String?   @db.VarChar(300)
  expected_date DateTime? @db.Timestamp(6)
  id_client     Int
  id_property   Int
  property      property  @relation(fields: [id_property], references: [id_property], onDelete: Cascade, onUpdate: NoAction, map: "invitation_property_fk")
  USER          USER      @relation(fields: [id_client], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "invitation_user_fk")
}

model property {
  id_property   Int          @id(map: "property_pk") @default(autoincrement())
  title         String       @db.VarChar(50)
  type          String       @db.VarChar(30)
  address       String       @db.VarChar(150)
  price         Decimal      @db.Decimal(8, 2)
  description   String       @db.VarChar(300)
  num_rooms     Decimal      @db.Decimal(4, 0)
  num_bathrooms Decimal      @db.Decimal(4, 0)
  square_meters Decimal      @db.Decimal(6, 2)
  state         String       @db.VarChar(30)
  zone          Decimal      @db.Decimal(3, 0)
  created_at    DateTime     @db.Timestamp(6)
  id_agent      Int
  favorite      favorite[]
  image         image[]
  invitation    invitation[]
  USER          USER         @relation(fields: [id_agent], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "property_user_fk")
  record        record[]
}

model record {
  id_record   Int      @id(map: "record_pk") @default(autoincrement())
  created_at  DateTime @db.Timestamp(6)
  id_client   Int
  id_property Int
  property    property @relation(fields: [id_property], references: [id_property], onDelete: Cascade, onUpdate: NoAction, map: "record_property_fk")
  USER        USER     @relation(fields: [id_client], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "record_user_fk")
}
